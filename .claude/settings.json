{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git fetch:*)",
      "Bash(git pull --ff-only:*)",
      "Bash(git add:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh repo view:*)",
      "Bash(myst build:*)",
      "Bash(myst start:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(jupyter nbconvert:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(conda run:*)",
      "Bash(conda env list:*)",
      "Bash(conda list:*)",
      "Bash(mamba run:*)",
      "Bash(git clone:*)",
      "Bash(pip install:*)",
      "Bash(conda install:*)",
      "Bash(mamba install:*)",
      "Bash(npm install:*)",
      "Bash(conda env create:*)",
      "Bash(conda env update:*)",
      "Bash(conda create:*)",
      "Bash(mamba env create:*)",
      "Bash(mamba create:*)",
      "Bash(mkdir:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(sort:*)",
      "Bash(jupyter:*)",
      "Bash(pytest:*)",
      "Bash(curl:*)",
      "Bash(git diff --stat:*)",
      "Bash(git commit:*)",
      "Bash(git fetch upstream:*)",
      "Bash(git worktree list:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(git rebase:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr review --approve:*)",
      "Bash(gh api:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --delete:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(git merge:*)",
      "Bash(git config:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.netrc)",
      "Read(~/.ssh/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)",
      "Write(./.claude/settings.json)",
      "Write(./.claude/hooks/**)",
      "Bash(git push origin dev:*)",
      "Edit(./01-data-best-practices/**)",
      "Write(./01-data-best-practices/**)",
      "Edit(./02-federal-water-data-landscape/**)",
      "Write(./02-federal-water-data-landscape/**)",
      "Edit(./.github/workflows/**)",
      "Write(./.github/workflows/**)",
      "Edit(./.claude/scripts/**)",
      "Write(./.claude/scripts/**)",
      "Bash(git push upstream main:*)",
      "Bash(git push upstream master:*)",
      "Bash(git push upstream dev:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_guard.sh\"",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}

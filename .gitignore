# Ignore local build artifacts
_build/*
.vscode/*
__pycache__/

# Teaching materials that stay local (see teaching-materials/how-to-build/guide.md)
# Session decks are built locally and shared through Canvas, never committed
teaching-materials/materials/slides/*.pptx
teaching-materials/materials/slides/*.potx
teaching-materials/materials/slides/*.pdf
# Templates folder: only the course deck template is committed; example decks, the reading template and
# scripts stay local. Also existing decks or readings to update.
teaching-materials/how-to-build/templates/*
!teaching-materials/how-to-build/templates/template.pptx
teaching-materials/how-to-build/to-update/
# Module readings (Word and PDF) are built locally and shared through Canvas, never committed
teaching-materials/materials/readings/*
!teaching-materials/materials/readings/.gitkeep
# Quizzes and answer keys are built locally and loaded into Canvas, never committed
teaching-materials/materials/quizzes/*
!teaching-materials/materials/quizzes/.gitkeep
